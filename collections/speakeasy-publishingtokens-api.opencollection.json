{
  "opencollection": "1.0.0",
  "info": {
    "name": "Speakeasy Artifacts PublishingTokens API",
    "version": "0.4.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "PublishingTokens",
